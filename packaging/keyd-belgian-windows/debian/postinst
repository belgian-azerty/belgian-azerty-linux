#!/bin/sh
set -e

if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    # keyd's own package enables the service; on first install make sure it is enabled, then let it read the rules.
    if [ -z "$2" ]; then
        deb-systemd-helper enable keyd.service >/dev/null 2>&1 || true
    fi
    deb-systemd-invoke restart keyd.service >/dev/null 2>&1 || true
fi
if [ "$1" = configure ]; then
    # keyd gives each keyboard one configuration only: say so when the user already has their own.
    for f in /etc/keyd/*.conf; do
        [ -f "$f" ] && [ "$f" != /etc/keyd/be-winaltgr.conf ] || continue
        echo "keyd-belgian-windows: $f exists. keyd uses one configuration per keyboard, so on keyboards that both" \
             "files match only one of them works. Put the Belgian rules into your own file, or limit one file under [ids]." >&2
    done
fi

#DEBHELPER#
