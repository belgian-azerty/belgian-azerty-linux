#!/bin/sh
set -e

RULES=/usr/share/X11/xkb/rules/evdev
OVERRIDE=/usr/share/glib-2.0/schemas/zz_belgian-azerty-windows.gschema.override

case "$1" in
    remove|purge|abort-install|disappear)
        # Give xkb-data its own rules file back (one rename, so it never goes missing), then drop the diversion.
        if dpkg-divert --list "$RULES" | grep -q belgian-azerty-windows; then
            if [ -f "$RULES.distrib" ]; then
                mv -f "$RULES.distrib" "$RULES"
            fi
            dpkg-divert --package belgian-azerty-windows --no-rename --remove "$RULES"
        fi
        # Without the rules, caps:be_windows, be_azerty:accents and be_azerty:mac are unknown options (ignored: Linux
        # Caps Lock and accents, PC layout); take them out of the system default too, so nothing refers to a removed
        # package. keyboard-configuration reads this file as its truth.
        if [ -f /etc/default/keyboard ] && grep -qE '^XKBOPTIONS=.*(caps:be_windows|be_azerty:)' /etc/default/keyboard; then
            sed -i -E '/^XKBOPTIONS=/{s/(caps:be_windows|be_azerty:[a-z_]+),?//g; s/,("?)$/\1/}' /etc/default/keyboard
        fi
        # Apple keyboard key swap written by "be-azerty-fix apple-iso-keys on|off". The setting is also copied into
        # the initramfs, so rebuild it once (only when the file was there).
        if [ -f /etc/modprobe.d/belgian-azerty-apple.conf ]; then
            rm -f /etc/modprobe.d/belgian-azerty-apple.conf
            if [ -w /sys/module/hid_apple/parameters/iso_layout ]; then
                echo -1 > /sys/module/hid_apple/parameters/iso_layout 2>/dev/null || true
            fi
            if command -v update-initramfs >/dev/null; then
                update-initramfs -u >/dev/null 2>&1 || true
            fi
        fi
        # Cinnamon defaults written by "be-azerty-fix system".
        if [ -f "$OVERRIDE" ]; then
            rm -f "$OVERRIDE"
            if command -v glib-compile-schemas >/dev/null; then
                glib-compile-schemas /usr/share/glib-2.0/schemas || true
            fi
        fi
        # ibus skip (automatic for the Terminal and the text editor, or "be-azerty-fix ibus-skip on ..."): remove each
        # user's marked menu-file copies and systemd drop-ins, as that user (so nothing outside their own files can be
        # hit). Purge also forgets the list and the automatic on/off choice.
        if [ "$1" = remove ] || [ "$1" = purge ]; then
            getent passwd | while IFS=: read -r u _ uid _ _ home _; do
                { [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ]; } || [ "$uid" = 0 ] || continue
                [ -d "$home" ] || continue
                runuser -u "$u" -- sh -c '
                    for f in "$1"/.local/share/applications/*.desktop; do
                        [ -f "$f" ] && grep -q "^X-BelgianAzerty-IbusSkip=" "$f" && rm -f "$f"
                    done
                    for f in "$1"/.config/systemd/user/*.d/zz-belgian-azerty-ibus-skip.conf; do
                        [ -f "$f" ] && rm -f "$f" && rmdir "${f%/*}" 2>/dev/null
                    done
                    if [ "$2" = purge ]; then
                        rm -f "$1/.config/belgian-azerty/ibus-skip" "$1/.config/belgian-azerty/ibus-skip-auto"
                        rmdir "$1/.config/belgian-azerty" 2>/dev/null
                    fi
                    true' sh "$home" "$1" || true
            done
        fi
        if [ "$1" = purge ]; then
            rm -rf /var/lib/belgian-azerty-windows   # choices saved by "be-azerty-fix system"
        fi
        ;;
esac

#DEBHELPER#
