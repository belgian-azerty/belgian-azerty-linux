[Desktop Entry]
Type=Application
Name=Belgian keyboard: ibus skip
Comment=Brings the ibus skip up to date at login: re-applies it when switched on, removes it when switched off
TryExec=/usr/sbin/be-azerty-fix
Exec=/usr/sbin/be-azerty-fix ibus-skip refresh
NoDisplay=true
X-GNOME-Autostart-enabled=true
