--- a/src/keyboard.c
+++ b/src/keyboard.c
@@ -240,6 +240,28 @@
 	}
 }
 
+/*
+ * Belgian AZERTY test patch: true while every layer that produced dl is still
+ * held (all constituents of a composite layer such as [control+alt]).
+ */
+static int layer_held(struct keyboard *kbd, int dl)
+{
+	struct layer *layer = &kbd->config.layers[dl];
+	size_t j;
+
+	if (dl <= 0)
+		return 0;
+
+	if (layer->type != LT_COMPOSITE)
+		return kbd->layer_state[dl].active > 0;
+
+	for (j = 0; j < layer->nr_constituents; j++)
+		if (!kbd->layer_state[layer->constituents[j]].active)
+			return 0;
+
+	return 1;
+}
+
 static void deactivate_layer(struct keyboard *kbd, int idx)
 {
 	dbg("Deactivating layer %s", kbd->config.layers[idx].name);
@@ -523,7 +545,17 @@
 			clear_oneshot(kbd);
 		} else {
 			send_key(kbd, new_code, 0);
-			update_mods(kbd, -1, 0);
+			/*
+			 * Belgian AZERTY test patch: while the layer that asked for
+			 * these modifiers (e.g. [control+alt] -> G-2) is still held,
+			 * keep them down instead of restoring the layer's own
+			 * modifiers between keys. Ctrl+Alt+2 E 2 E then reaches the
+			 * desktop like AltGr held + 2 E 2 E (2 events per key, not 8).
+			 * The next key press or the layer's release sets the right
+			 * modifiers anyway (update_mods on press and on layer change).
+			 */
+			if (!(mods && layer_held(kbd, dl)))
+				update_mods(kbd, -1, 0);
 		}
 
 		if (!mods)
