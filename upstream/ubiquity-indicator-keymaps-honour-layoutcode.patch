+    def preseeded_layout():
+        """The layout given on the boot line (keyboard-configuration/layoutcode=,
+        applied to /etc/default/keyboard by casper), or None. A user who said
+        which keyboard they have must not get the language's guess instead:
+        fr_BE/nl_BE users boot with layoutcode=be and would otherwise get
+        French (fr_oss) or Dutch (nl) first."""
+        try:
+            with open('/proc/cmdline') as f:
+                if 'layoutcode=' not in f.read():
+                    return None
+            values = {}
+            with open('/etc/default/keyboard') as f:
+                for line in f:
+                    if '=' in line and not line.lstrip().startswith('#'):
+                        key, value = line.strip().split('=', 1)
+                        values[key] = value.strip('"').split(',')[0]
+        except OSError:
+            return None
+        layout = values.get('XKBLAYOUT')
+        if not layout:
+            return None
+        variant = values.get('XKBVARIANT')
+        return '%s\t%s' % (layout, variant) if variant else layout
+
