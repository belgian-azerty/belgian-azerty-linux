# Automated Mint install for the extra tests (ubiquity --automatic); Belgian layout, whole virtual disk /dev/vda
d-i debian-installer/locale string nl_BE.UTF-8
d-i localechooser/supported-locales multiselect nl_BE.UTF-8
d-i keyboard-configuration/layoutcode string be
d-i keyboard-configuration/xkb-keymap select be
d-i keyboard-configuration/variantcode string
d-i time/zone string Europe/Brussels
d-i clock-setup/utc boolean true
d-i partman-auto/disk string /dev/vda
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i passwd/user-fullname string be
d-i passwd/username string be
d-i passwd/user-password password <test-password>
d-i passwd/user-password-again password <test-password>
d-i passwd/auto-login boolean true
d-i user-setup/allow-password-weak boolean true
d-i grub-installer/bootdev string /dev/vda
d-i grub-installer/only_debian boolean true
ubiquity ubiquity/use_nonfree boolean false
ubiquity ubiquity/download_updates boolean false
ubiquity ubiquity/reboot boolean false
ubiquity ubiquity/poweroff boolean false
