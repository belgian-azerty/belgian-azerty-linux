--- mutter-46.2.orig/src/core/events.c
+++ mutter-46.2/src/core/events.c
@@ -88,6 +88,27 @@ stage_has_grab (MetaDisplay *display)
   return clutter_stage_get_grab_actor (stage) != NULL;
 }
 
+/* EXPERIMENT (Belgian AZERTY project, emulator only): a key event that a ClutterText of the shell (password dialog,
+ * lock screen) passed to the input method was already counted in the Wayland keyboard state when it arrived from the
+ * hardware. The input method's copy (CLUTTER_EVENT_FLAG_INPUT_METHOD) must not count it again: when the copy of a
+ * press arrives after the hardware release, update_pressed_keys() accepts it as a new press and Caps Lock toggles twice
+ * for Wayland clients but once for the seat. */
+static gboolean
+is_shell_im_copy (MetaDisplay        *display,
+                  const ClutterEvent *event)
+{
+  ClutterEventType type = clutter_event_type (event);
+  ClutterActor *focus;
+
+  if (type != CLUTTER_KEY_PRESS && type != CLUTTER_KEY_RELEASE)
+    return FALSE;
+  if (!(clutter_event_get_flags (event) & CLUTTER_EVENT_FLAG_INPUT_METHOD))
+    return FALSE;
+
+  focus = clutter_stage_get_key_focus (stage_from_display (display));
+  return focus && CLUTTER_IS_TEXT (focus);
+}
+
 static MetaWindow *
 get_window_for_event (MetaDisplay        *display,
                       const ClutterEvent *event,
@@ -292,7 +313,7 @@ meta_display_handle_event (MetaDisplay
       meta_wayland_text_input_update (wayland_text_input, event))
     return CLUTTER_EVENT_STOP;
 
-  if (wayland_compositor)
+  if (wayland_compositor && !is_shell_im_copy (display, event))
     meta_wayland_compositor_update (wayland_compositor, event);
 #endif
 
