typing: cd /tmp && for f in keyd_backport_amd64.deb keyd-belgian-windows_0.9.1_all.deb belgian-azerty-windows_0.9.1_all.deb kbstate.sh durability-guest.sh; do wget -q http://10.0.2.2:8000/$f; done; sha256sum *.deb *.sh > dl.txt; bash kbstate.sh pre-install > pre.txt 2>&1; for x in dl pre; do wget -q --post-file=$x.txt http://10.0.2.2:8001/zi-$x-install.txt -O /dev/null; done; clear; echo DONE
typing: sudo apt-get -o DPkg::Lock::Timeout=600 install -y ./keyd_backport_amd64.deb ./keyd-belgian-windows_0.9.1_all.deb ./belgian-azerty-windows_0.9.1_all.deb 2>&1 | tee /tmp/apt-install.log; sudo be-azerty-fix system 2>&1 | tee /tmp/fix-system.log; dpkg -s belgian-azerty-windows keyd-belgian-windows keyd | grep -E '^(Package|Version|Maintainer|Status)' > /tmp/maint.txt; bash /tmp/kbstate.sh after-fix-system > /tmp/state-after-fix.txt 2>&1; for x in apt-install fix-system maint state-after-fix; do wget -q --post-file=/tmp/$x.txt http://10.0.2.2:8001/zi-$x.txt -O /dev/null; done; echo ALLDONE
typing: clear; for x in apt-install fix-system; do wget -q --post-file=/tmp/$x.log http://10.0.2.2:8001/zi-$x.log -O /dev/null; done; dpkg -s belgian-azerty-windows | grep Maintainer > /tmp/maint2.txt; dpkg -l keyd keyd-belgian-windows belgian-azerty-windows >> /tmp/maint2.txt; wget -q --post-file=/tmp/maint2.txt http://10.0.2.2:8001/zi-maint2.txt -O /dev/null; echo UPDONE
typing: sudo reboot
typing: cd /tmp && for f in kbstate.sh durability-guest.sh; do wget -q http://10.0.2.2:8000/$f; done; ls -la /tmp/*.sh; journalctl -b --no-pager -o short-monotonic > /tmp/j2.txt; wget -q --post-file=/tmp/j2.txt http://10.0.2.2:8001/boot2-journal.txt -O /dev/null; clear
typing: clear; sudo be-azerty-fix check 2>&1 | tee /tmp/check.log; wget -q --post-file=/tmp/check.log http://10.0.2.2:8001/zi-check.log -O /dev/null; echo CHECKDONE
typing: sudo poweroff
