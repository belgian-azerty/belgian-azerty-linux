#!/bin/sh
set -e
case "$1" in
    remove|deconfigure)
        /usr/lib/world-keyboard-windows/xkb-files remove
        # A system default that names one of our layouts would point at a missing layout after removal (the
        # keyboard could fall back to US): the Linux layout it was made from goes back (de_windows -> de).
        /usr/lib/world-keyboard-windows/xkb-files fallback ;;
esac
#DEBHELPER#
