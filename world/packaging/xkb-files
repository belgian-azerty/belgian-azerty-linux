#!/bin/sh
# world-keyboard-windows: put the "(Windows)" layout files into the system keyboard folder, or take them out.
# The package keeps its own copy in /usr/lib/world-keyboard-windows/symbols and copies it to the real folder
# (readlink -f, so /usr/share/xkeyboard-config-2/symbols on xkb-data 2.46+). The copies belong to no package, and
# every copy starts with our marker line, so only our own files are ever replaced or removed.
#   xkb-files put       copy our files (postinst), and our layout list to /etc/xkb/rules/evdev.xml
#   xkb-files take      remove our layout files (before an xkb-data 2.46 folder switch)
#   xkb-files remove    remove our layout files and our layout list (prerm on remove)
# The layout list: desktops that use libxkbregistry (GNOME 44+, KDE) only show and only accept layouts listed in a
# rules/evdev.xml of one of the keyboard folders; libxkbregistry reads /etc/xkb/rules/evdev.xml next to the system
# one. A file there that is not ours is left alone (then our layouts are not listed).
#   xkb-files prepare   apt hook before dpkg (.deb names on stdin): if xkb-data 2.46+ is about to replace the folder
#                       by a link, take our files out first. xkb-data refuses the switch while the folder holds files
#                       that are not its own (the problem 0.9.11/0.9.12 of belgian-azerty-windows fixed).
#   xkb-files finish    apt hook after dpkg: put them back once xkb-data is configured.
#   xkb-files fallback  /etc/default/keyboard naming one of our layouts: put the Linux layout back (prerm on remove)
#   xkb-files status    list our files in the folder
# Never stops apt or dpkg: errors are reported and ignored. Not covered: xkb-data installed with plain "dpkg -i".
LIB=/usr/lib/world-keyboard-windows
MARK=/var/lib/world-keyboard-windows/xkb-move-pending
TAG='generated by world/tools/gen_windows_symbols.py'
symdir() { readlink -f /usr/share/X11/xkb/symbols; }
ours() { [ -f "$1" ] && head -1 "$1" | grep -qF "$TAG"; }

take() {
    d=$(symdir); [ -d "$d" ] || return 0
    for f in "$d"/*_windows; do ours "$f" && rm -f "$f"; done
    return 0
}
put() {
    d=$(symdir); [ -d "$d" ] || { echo "world-keyboard-windows: no keyboard folder, nothing copied" >&2; return 0; }
    take
    for f in "$LIB"/symbols/*; do
        n=${f##*/}
        if [ -e "$d/$n" ]; then echo "world-keyboard-windows: $d/$n exists and is not ours: left alone" >&2; continue; fi
        install -m 644 "$f" "$d/$n"
    done
}
REG=/etc/xkb/rules/evdev.xml
reg_ours() { [ -f "$REG" ] && sed -n 3p "$REG" | grep -qF "$TAG"; }
put_reg() {
    if [ -e "$REG" ] && ! reg_ours; then echo "world-keyboard-windows: $REG exists and is not ours: left alone, our layouts are not listed" >&2; return 0; fi
    mkdir -p "${REG%/*}"; install -m 644 "$LIB/evdev.xml" "$REG"
}
take_reg() {
    reg_ours || return 0
    rm -f "$REG"; rmdir "${REG%/*}" 2>/dev/null; rmdir /etc/xkb 2>/dev/null; return 0
}
prepare() {
    new=
    while read -r deb; do
        case "${deb##*/}" in
            xkb-data_*.deb) v=$(dpkg-deb -f "$deb" Version 2>/dev/null) || continue
                            dpkg --compare-versions "$v" ge 2.46~ && new=$v ;;
        esac
    done
    [ -n "$new" ] || return 0
    [ -d /usr/share/X11/xkb ] && [ ! -L /usr/share/X11/xkb ] || return 0
    mkdir -p "${MARK%/*}"; : > "$MARK"; take
    echo "world-keyboard-windows: xkb-data $new moves the keyboard folder; the (Windows) layouts step aside and come back after the update." >&2
}
finish() {
    [ -f "$MARK" ] || return 0
    [ -d "$LIB/symbols" ] || { rm -f "$MARK"; return 0; }
    case "$(dpkg-query -W -f='${db:Status-Abbrev}' xkb-data 2>/dev/null)" in ii*) ;; *) return 0 ;; esac
    put; rm -f "$MARK"
    echo "world-keyboard-windows: the (Windows) layouts are back ($(symdir))." >&2
}
fallback() {     # on removal: a system default naming one of our layouts gets the Linux layout it was made from
    F=/etc/default/keyboard
    [ -f "$F" ] && grep -q '^XKBLAYOUT=.*_windows' "$F" || return 0
    tmp=$(mktemp "$F.XXXXXX") || return 0
    awk -v map="$LIB/fallback.tsv" '
        BEGIN { while ((getline row < map) > 0) { split(row, a, "\t"); m[a[1] "(" a[2] ")"] = a[3] "\t" a[4] } }
        function unq(s) { gsub(/^"|"$/, "", s); return s }
        { keep[NR] = $0 }
        /^XKBLAYOUT=/  { L = unq(substr($0, 11)); li = NR }
        /^XKBVARIANT=/ { V = unq(substr($0, 12)); vi = NR }
        END {
            n = split(L, l, ","); split(V, v, ",")
            for (i = 1; i <= n; i++) {
                k = l[i] "(" (v[i] == "" ? "basic" : v[i]) ")"
                if (k in m) { split(m[k], b, "\t"); l[i] = b[1]; v[i] = (b[2] == "basic" ? "" : b[2]) }
            }
            nl = l[1]; nv = v[1]; for (i = 2; i <= n; i++) { nl = nl "," l[i]; nv = nv "," v[i] }
            for (i = 1; i <= NR; i++)
                if (i == li) print "XKBLAYOUT=\"" nl "\""; else if (i == vi) print "XKBVARIANT=\"" nv "\""; else print keep[i]
            if (!vi && nv ~ /[^,]/) print "XKBVARIANT=\"" nv "\""
        }' "$F" > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$F" &&
        echo "world-keyboard-windows: $F set back to the Linux layout ($(grep '^XKBLAYOUT=' "$F"))" >&2
    rm -f "$tmp"
}
case "${1:-status}" in
    fallback) fallback || true ;;
    put) put || true; put_reg || true ;;
    take) take || true ;;
    remove) take || true; take_reg || true ;;
    prepare) prepare || true ;;
    finish) finish || true ;;
    status) d=$(symdir); for f in "$d"/*_windows; do ours "$f" && echo "$f"; done; reg_ours && echo "$REG"; true ;;
esac
exit 0
