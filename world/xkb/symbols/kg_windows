default partial alphanumeric_keys
xkb_symbols "basic" {
    include "kg"
    name[Group1] = "Kyrgyz (as on Windows)";
    // Windows layout: "Kyrgyz Cyrillic" (CLDR ky-t-k0-windows.xml); 7 keys differ from Linux
    include "level3(ralt_switch)"   // Right Alt is AltGr, as on Windows
    // altgr: Windows ө / Linux о; shiftaltgr: Windows Ө / Linux О
    key <AC07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_o, Cyrillic_O, Cyrillic_o_bar, Cyrillic_O_bar ] };
    // altgr: Windows ү / Linux у; shiftaltgr: Windows Ү / Linux У
    key <AD03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_u, Cyrillic_U, Cyrillic_u_straight, Cyrillic_U_straight ] };
    // altgr: Windows ң / Linux н; shiftaltgr: Windows Ң / Linux Н
    key <AD06> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_en, Cyrillic_EN, Cyrillic_en_descender, Cyrillic_EN_descender ] };
    // base: Windows - / Linux ө; shift: Windows _ / Linux Ө; caps: Windows - / Linux Ө; capsshift: Windows _ / Linux ө
    key <AE11> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ minus, underscore, Cyrillic_o_bar, Cyrillic_O_bar, minus ] };
    // base: Windows = / Linux ң; shift: Windows + / Linux Ң; caps: Windows = / Linux Ң; capsshift: Windows + / Linux ң
    key <AE12> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ equal, plus, Cyrillic_en_descender, Cyrillic_EN_descender, equal ] };
    // base: Windows \ / Linux ү; shift: Windows / / Linux Ү; caps: Windows \ / Linux Ү; capsshift: Windows / / Linux ү
    key <BKSL> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ backslash, slash, Cyrillic_u_straight, Cyrillic_U_straight, backslash ] };
    // base: Windows \ / Linux /; shift: Windows / / Linux |; caps: Windows \ / Linux /; capsshift: Windows / / Linux |
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, slash, bar, brokenbar ] };
};
