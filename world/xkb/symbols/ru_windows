default partial alphanumeric_keys
xkb_symbols "basic" {
    include "ru"
    name[Group1] = "Russian (as on Windows)";
    // Windows layout: "Russian" (CLDR ru-t-k0-windows.xml); 1 keys differ from Linux
    include "level3(ralt_switch)"   // Right Alt is AltGr, as on Windows
    // base: Windows \ / Linux /; shift: Windows / / Linux |; caps: Windows \ / Linux /; capsshift: Windows / / Linux |
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, slash, bar, brokenbar ] };
};

partial alphanumeric_keys
xkb_symbols "typewriter" {
    include "ru(typewriter)"
    name[Group1] = "Russian (Typewriter, as on Windows)";
    // Windows layout: "Russian (Typewriter)" (CLDR ru-t-k0-windows-legacy.xml); 2 keys differ from Linux
    include "level3(ralt_switch)"   // Right Alt is AltGr, as on Windows
    // altgr: Windows ₽ / Linux _
    key <AE08> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ underscore, 8, U20BD, 8 ] };
    // base: Windows ) / Linux /; shift: Windows ( / Linux |; caps: Windows ) / Linux /; capsshift: Windows ( / Linux |
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ parenright, parenleft, bar, brokenbar ] };
};
