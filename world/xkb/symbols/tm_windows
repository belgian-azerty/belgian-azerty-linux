default partial alphanumeric_keys
xkb_symbols "basic" {
    include "tm"
    name[Group1] = "Turkmen (as on Windows)";
    // Windows layout: "Turkmen" (CLDR tk-t-k0-windows.xml); 4 keys differ from Linux
    // altgr: Windows \ / Linux /
    key <AB10> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ slash, question, backslash, question ] };
    // shift: Windows № / Linux ^; capsshift: Windows № / Linux ^
    key <AE06> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 6, numerosign, 6, asciicircum ] };
    // altgr: Windows | / Linux \
    key <BKSL> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ scedilla, Scedilla, bar, bar ] };
    // base: Windows \ / Linux <; shift: Windows | / Linux >; caps: Windows \ / Linux <; capsshift: Windows | / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, bar, bar, brokenbar ] };
};
