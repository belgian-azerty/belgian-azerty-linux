default partial alphanumeric_keys
xkb_symbols "basic" {
    include "bg"
    name[Group1] = "Bulgarian (Typewriter, as on Windows)";
    // Windows layout: "Bulgarian (Typewriter)" (CLDR bg-t-k0-windows-legacy.xml); 8 keys differ from Linux
    // base: Windows ` / Linux (; shift: Windows ~ / Linux ); caps: Windows ` / Linux (; capsshift: Windows ~ / Linux )
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ grave, asciitilde, parenleft, parenright ] };
    // shift: Windows Ь / Linux ѝ; capsshift: Windows ь / Linux Ѝ
    key <AC01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_softsign, Cyrillic_SOFTSIGN, Cyrillic_softsign, U045D ] };
    // capsshift: Windows ы / Linux Ы
    key <AD01> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ comma, Cyrillic_yeru, comma, Cyrillic_yeru, comma ] };
    // shift: Windows _ / Linux –; capsshift: Windows _ / Linux –
    key <AE09> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 9, underscore, 9, endash ] };
    // shift: Windows І / Linux $; capsshift: Windows І / Linux $
    key <AE11> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ minus, Ukrainian_I, minus, dollar, minus ] };
    // shift: Windows V / Linux €; capsshift: Windows V / Linux €
    key <AE12> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ period, V, period, EuroSign, period ] };
    // base: Windows ( / Linux „; shift: Windows ) / Linux “; caps: Windows ( / Linux „; capsshift: Windows ) / Linux “
    key <BKSL> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ parenleft, parenright, doublelowquotemark, leftdoublequotemark ] };
    // base: Windows \ / Linux ѝ; shift: Windows | / Linux Ѝ; caps: Windows \ / Linux Ѝ; capsshift: Windows | / Linux ѝ
    key <LSGT> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ backslash, bar, U045D, U040D, backslash ] };
};

partial alphanumeric_keys
xkb_symbols "phonetic_trad" {
    include "bg(phonetic)"
    name[Group1] = "Bulgarian (Phonetic Traditional, as on Windows)";
    // Windows layout: "Bulgarian (Phonetic Traditional)" (CLDR bg-t-k0-windows-qwerty-legacy.xml); 6 keys differ from Linux
    include "level3(ralt_switch)"   // Right Alt is AltGr, as on Windows
    // shift: Windows < / Linux „; capsshift: Windows < / Linux „
    key <AB08> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ comma, less, guillemetleft, guillemetleft ] };
    // shift: Windows > / Linux “; capsshift: Windows > / Linux “
    key <AB09> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ period, greater, guillemetright, guillemetright ] };
    // shiftaltgr: Windows Ы / Linux Ш
    key <AD11> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_sha, Cyrillic_SHA, Cyrillic_sha, Cyrillic_YERU ] };
    // shiftaltgr: Windows Э / Linux Щ
    key <AD12> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_shcha, Cyrillic_SHCHA, Cyrillic_shcha, Cyrillic_E ] };
    // shift: Windows _ / Linux –; capsshift: Windows _ / Linux –
    key <AE11> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ minus, underscore, U2011, U2011 ] };
    // base: Windows ю / Linux ѝ; shift: Windows Ю / Linux Ѝ; caps: Windows Ю / Linux Ѝ; capsshift: Windows ю / Linux ѝ
    key <LSGT> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_yu, Cyrillic_YU, bar, brokenbar ] };
};
