default partial alphanumeric_keys
xkb_symbols "basic" {
    include "it"
    name[Group1] = "Italian (as on Windows)";
    // Windows layout: "Italian" (CLDR it-t-k0-windows.xml); 6 keys differ from Linux
    // caps: Windows ò / Linux Ò; capsshift: Windows ç / Linux Ç
    key <AC10> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ ograve, ccedilla, at, dead_cedilla, ograve ] };
    // caps: Windows à / Linux À
    key <AC11> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ agrave, degree, numbersign, dead_abovering, agrave ] };
    // caps: Windows è / Linux È; capsshift: Windows é / Linux É
    key <AD11> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ egrave, eacute, bracketleft, braceleft, egrave ] };
    // altgr: Windows € / Linux ½
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 5, percent, EuroSign, threeeighths ] };
    // caps: Windows ì / Linux Ì
    key <AE12> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ igrave, asciicircum, asciitilde, dead_circumflex, igrave ] };
    // caps: Windows ù / Linux Ù
    key <BKSL> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ ugrave, section, dead_grave, dead_breve, ugrave ] };
};
