// Part of the world prototype of belgian-azerty-linux; not released.

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "is"
    name[Group1] = "Icelandic (as on Windows)";
    // Windows layout: "Icelandic" (CLDR is-t-k0-windows.xml); 4 keys differ from Linux
    // altgr: Windows ° / Linux ¬
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ dead_abovering, dead_diaeresis, degree, hyphen ] };
    // shift: Windows ' / Linux dead:´; capsshift: Windows ' / Linux dead:´
    key <AC11> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ dead_acute, apostrophe, dead_circumflex, dead_caron ] };
    // altgr: Windows € / Linux ½
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 5, percent, EuroSign, threeeighths ] };
    // altgr: Windows dead:` / Linux `
    key <BKSL> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ plus, asterisk, dead_grave, dead_breve ] };
};
