default partial alphanumeric_keys
xkb_symbols "basic" {
    include "mt(us)"
    name[Group1] = "Maltese (47-key, as on Windows)";
    // Windows layout: "Maltese 47-Key" (CLDR mt-t-k0-windows-101key.xml); 1 keys differ from Linux
    // altgr: Windows £ / Linux #
    key <AE03> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 3, EuroSign, sterling, sterling ] };
};
