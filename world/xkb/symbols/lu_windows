default partial alphanumeric_keys
xkb_symbols "basic" {
    include "ch(fr)"
    name[Group1] = "Luxembourgish (as on Windows)";
    // Windows layout: "Luxembourgish" (CLDR lb-t-k0-windows.xml); 6 keys differ from Linux
    // caps: Windows é / Linux É; capsshift: Windows ö / Linux Ö
    key <AC10> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ eacute, odiaeresis, dead_acute, dead_doubleacute, eacute ] };
    // caps: Windows à / Linux À; capsshift: Windows ä / Linux Ä
    key <AC11> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ agrave, adiaeresis, braceleft, dead_caron, agrave ] };
    // caps: Windows è / Linux È; capsshift: Windows ü / Linux Ü
    key <AD11> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ egrave, udiaeresis, bracketleft, dead_abovering, egrave ] };
    // altgr: Windows ¦ / Linux |
    key <AE01> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 1, plus, brokenbar, exclamdown ] };
    // capsshift: Windows ç / Linux Ç; altgr: Windows ° / Linux ¼
    key <AE04> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ 4, ccedilla, degree, dollar, 4 ] };
    // altgr: Windows § / Linux ½
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 5, percent, section, threeeighths ] };
};
