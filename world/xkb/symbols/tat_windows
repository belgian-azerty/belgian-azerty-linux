    key <AB08> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_be, Cyrillic_BE, less, Cyrillic_BE ] };
    // altgr: Windows > / Linux ю
    key <AB09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_yu, Cyrillic_YU, greater, Cyrillic_YU ] };
