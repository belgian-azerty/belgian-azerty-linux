default partial alphanumeric_keys
xkb_symbols "basic" {
    include "si"
    name[Group1] = "Slovenian (as on Windows)";
    // Windows layout: "Slovenian" (CLDR sl-t-k0-windows.xml); 4 keys differ from Linux
    // base: Windows dead:¸ / Linux ¸; shift: Windows dead:¨ / Linux ¨; caps: Windows dead:¸ / Linux ¸; capsshift: Windows dead:¨ / Linux ¨  [shift: accent key ¨ as on Windows; Linux accent table differs on 1 sequences (e.g.  ->¨ (Linux ")): accent-space gives the Windows results]
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ dead_cedilla, dead_diaeresis, cedilla, diaeresis ] };
    // altgr: Windows Ł / Linux ł
    key <AC09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ l, L, Lstroke, Lstroke ] };
    // altgr: Windows ~ / Linux dead:~
    key <AE01> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 1, exclam, asciitilde, asciitilde ] };
    // altgr: Windows ` / Linux dead:`
    key <AE07> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 7, slash, grave, grave ] };
};
