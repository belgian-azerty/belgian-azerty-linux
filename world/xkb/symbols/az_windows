default partial alphanumeric_keys
xkb_symbols "basic" {
    include "az"
    name[Group1] = "Azerbaijani (Latin, as on Windows)";
    // Windows layout: "Azeri Latin" (CLDR az-t-k0-windows.xml); 3 keys differ from Linux
    // caps: Windows I / Linux ı; capsshift: Windows ı / Linux I
    key <AC10> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ idotless, I, idotless, I ] };
    // caps: Windows İ / Linux I; capsshift: Windows i / Linux İ
    key <AD08> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ i, Iabovedot, i, Iabovedot ] };
    // base: Windows \ / Linux <; shift: Windows / / Linux >; caps: Windows \ / Linux <; capsshift: Windows / / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, slash, bar, brokenbar ] };
};

partial alphanumeric_keys
xkb_symbols "cyrillic" {
    include "az(cyrillic)"
    name[Group1] = "Azerbaijani (Cyrillic, as on Windows)";
    // Windows layout: "Azeri Cyrillic" (CLDR az-Cyrl-t-k0-windows.xml); 3 keys differ from Linux
    // shift: Windows № / Linux #; capsshift: Windows № / Linux #
    key <AE03> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 3, numerosign, 3, numbersign ] };
    // shift: Windows / / Linux |; capsshift: Windows / / Linux |
    key <BKSL> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, slash, backslash, bar ] };
    // base: Windows \ / Linux <; shift: Windows | / Linux >; caps: Windows \ / Linux <; capsshift: Windows | / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, bar, bar, brokenbar ] };
};
