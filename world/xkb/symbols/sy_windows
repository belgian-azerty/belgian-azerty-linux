    key <AB02> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U0728, U0735, Arabic_sukun, U0735 ] };
    // altgr: Windows ‍ / Linux ‌
    key <AB04> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U072B, U073C, U200D, NoSymbol ] };
    // altgr: Windows ‌ / Linux ‎
    key <AB05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U0712, U073F, U200C, NoSymbol ] };
    // altgr: Windows ‎ / Linux ‏
    key <AB06> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U0722, U0739, U200E, NoSymbol ] };
    // altgr: Windows ‏ / Linux ܡ
    key <AB07> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U0721, U0742, U200F, U0742 ] };
    // base: Windows ܆ / Linux <; shift: Windows : / Linux >; caps: Windows ܆ / Linux <; capsshift: Windows : / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U0706, colon, bar, brokenbar ] };
