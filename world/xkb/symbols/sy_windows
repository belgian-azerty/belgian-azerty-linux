default partial alphanumeric_keys
xkb_symbols "basic" {
    include "sy(syc)"
    name[Group1] = "Syriac (as on Windows)";
    // Windows layout: "Syriac" (CLDR syr-t-k0-windows.xml); 6 keys differ from Linux
    include "level3(ralt_switch)"   // Right Alt is AltGr, as on Windows
    // altgr: Windows ْ / Linux [
    key <AB02> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ bracketleft, U0735, Arabic_sukun, U0735 ] };
    // altgr: Windows ‍ / Linux ‌
    key <AB04> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U072A, U073C, U200D, NoSymbol ] };
    // altgr: Windows ‌ / Linux ‎
    key <AB05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U0727, U073F, U200C, NoSymbol ] };
    // altgr: Windows ‎ / Linux ‏
    key <AB06> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U0700, U0739, U200E, NoSymbol ] };
    // altgr: Windows ‏ / Linux .
    key <AB07> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ period, U0742, U200F, U0742 ] };
    // base: Windows ܆ / Linux <; shift: Windows : / Linux >; caps: Windows ܆ / Linux <; capsshift: Windows : / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U0706, colon, bar, brokenbar ] };
};

partial alphanumeric_keys
xkb_symbols "phonetic" {
    include "sy(syc_phonetic)"
    name[Group1] = "Syriac (Phonetic, as on Windows)";
    // Windows layout: "Syriac Phonetic" (CLDR syr-t-k0-windows-qwerty.xml); 6 keys differ from Linux
