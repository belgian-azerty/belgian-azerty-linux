default partial alphanumeric_keys
xkb_symbols "basic" {
    include "nl"
    name[Group1] = "Dutch (as on Windows)";
    // Windows layout: "Dutch" (CLDR nl-t-k0-windows.xml); 2 keys differ from Linux
    // altgr: Windows µ / Linux μ
    key <AB07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ m, M, mu, ordmasculine ] };
    // altgr: Windows ¦ / Linux |
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ bracketright, bracketleft, brokenbar, brokenbar ] };
};
