default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(haw)"
    name[Group1] = "Hawaiian (as on Windows)";
    // Windows layout: "Hawaiian" (CLDR haw-t-k0-windows.xml); 2 keys differ from Linux
    // caps: Windows " / Linux ʻ; capsshift: Windows ʻ / Linux "; shiftaltgr: Windows " / Linux None
    key <AC11> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ U02BB, quotedbl, apostrophe, quotedbl ] };
    // base: Windows \ / Linux <; shift: Windows | / Linux >; caps: Windows \ / Linux <; capsshift: Windows | / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, bar, bar, brokenbar ] };
};
