default partial alphanumeric_keys
xkb_symbols "basic" {
    include "iq(ku_ara)"
    name[Group1] = "Kurdish (Central, Arabic script, as on Windows)";
    // Windows layout: "Central Kurdish" (CLDR ckb-t-k0-windows.xml); 6 keys differ from Linux
    // base: Windows ` / Linux ‍; shift: Windows ~ / Linux ÷; caps: Windows ` / Linux ‍; capsshift: Windows ~ / Linux ÷
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ grave, asciitilde, asciitilde, NoSymbol ] };
    // shift: Windows ` / Linux X; capsshift: Windows ` / Linux X
    key <AD01> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ Arabic_qaf, grave, q, Q, Arabic_qaf ] };
    // shift: Windows ي / Linux ه; capsshift: Windows ي / Linux ه
    key <AD03> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ U06D5, Arabic_yeh, e, E, U06D5 ] };
    // shift: Windows ٪ / Linux %; capsshift: Windows ٪ / Linux %
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ Arabic_5, Arabic_percent, 5, Arabic_percent ] };
    // shift: Windows _ / Linux ـ; capsshift: Windows _ / Linux ـ
    key <AE11> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ minus, underscore, underscore, NoSymbol ] };
    // base: Windows \ / Linux <; shift: Windows / / Linux >; caps: Windows \ / Linux <; capsshift: Windows / / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, slash, bar, brokenbar ] };
};
