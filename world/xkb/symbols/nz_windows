default partial alphanumeric_keys
xkb_symbols "basic" {
    include "nz(mao)"
    name[Group1] = "Maori (as on Windows)";
    // Windows layout: "Maori" (CLDR mi-t-k0-windows.xml); 2 keys differ from Linux
    // base: Windows dead:` / Linux `; caps: Windows dead:` / Linux `  [base: accent key ` as on Windows; Linux accent table differs on 12 sequences (e.g.  ->~ (Linux `), `->` (Linux None), a->ā (Linux à)): accent-space gives the Windows results]
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ dead_grave, asciitilde, notsign, notsign ] };
    // base: Windows \ / Linux <; shift: Windows | / Linux >; caps: Windows \ / Linux <; capsshift: Windows | / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, bar, bar, brokenbar ] };
};
