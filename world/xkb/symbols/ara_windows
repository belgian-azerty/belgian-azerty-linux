xkb_symbols "basic" {
    include "ara"
    name[Group1] = "Arabic (101, as on Windows)";
    // Windows layout: "Arabic (101)" (CLDR ar-t-k0-windows.xml); 3 keys differ from Linux
    // shift: Windows ’ / Linux '; capsshift: Windows ’ / Linux '
    key <AB07> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ Arabic_tehmarbuta, rightsinglequotemark, NoSymbol, NoSymbol ] };
    // shift: Windows ‘ / Linux `; capsshift: Windows ‘ / Linux `
    key <AD07> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ Arabic_ain, leftsinglequotemark, NoSymbol, U202B ] };
