default partial alphanumeric_keys
xkb_symbols "basic" {
    include "pl(basic)"
    name[Group1] = "Polish (Programmers, as on Windows)";
    // Windows layout: "Polish (Programmers)" (CLDR pl-t-k0-windows-extended.xml); 2 keys differ from Linux
    // altgr: Windows € / Linux ↓
    key <AD07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ u, U, EuroSign, uparrow ] };
    // base: Windows \ / Linux <; shift: Windows | / Linux >; caps: Windows \ / Linux <; capsshift: Windows | / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ backslash, bar, bar, brokenbar ] };
};

partial alphanumeric_keys
xkb_symbols "qwertz" {
    include "pl(qwertz)"
    name[Group1] = "Polish (214, as on Windows)";
    // Windows layout: "Polish (214)" (CLDR pl-t-k0-windows.xml); 10 keys differ from Linux
    // base: Windows dead:˛ / Linux ˙; shift: Windows dead:· / Linux dead:˛; caps: Windows dead:˛ / Linux ˙; capsshift: Windows dead:· / Linux dead:˛  [shift: no keysym for 'dead:·', kept Linux]
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ dead_ogonek, dead_ogonek, notsign, notsign ] };
    // caps: Windows ą / Linux Ą; capsshift: Windows ę / Linux Ę
    key <AC11> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ aogonek, eogonek, ssharp, dead_caron, aogonek ] };
    // altgr: Windows ¦ / Linux |
    key <AD02> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ w, W, brokenbar, Greek_SIGMA ] };
    // altgr: Windows € / Linux ↓
    key <AD07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ u, U, EuroSign, uparrow ] };
    // caps: Windows ż / Linux Ż; capsshift: Windows ń / Linux Ń
    key <AD11> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ zabovedot, nacute, division, dead_abovering, zabovedot ] };
    // caps: Windows ś / Linux Ś; capsshift: Windows ć / Linux Ć
    key <AD12> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ sacute, cacute, multiply, dead_macron, sacute ] };
    // shift: Windows ¤ / Linux $; capsshift: Windows ¤ / Linux $
    key <AE04> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 4, currency, dead_breve, dollar ] };
    // altgr: Windows dead:° / Linux °
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 5, percent, dead_abovering, threeeighths ] };
    // altgr: Windows ` / Linux dead:`
    key <AE07> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 7, slash, grave, seveneighths ] };
    // caps: Windows ó / Linux Ó; capsshift: Windows ź / Linux Ź
    key <BKSL> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ oacute, zacute, dead_grave, dead_breve, oacute ] };
};
