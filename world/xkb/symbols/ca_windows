default partial alphanumeric_keys
xkb_symbols "basic" {
    include "ca(fr-legacy)"
    name[Group1] = "French (Canada, legacy, as on Windows)";
    // Windows layout: "Canadian French (Legacy)" (CLDR fr-CA-t-k0-windows-legacy.xml); 5 keys differ from Linux
    // shiftaltgr: Windows ¡ / Linux None
    key <AE01> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 1, exclam, onesuperior, exclamdown ] };
    // shiftaltgr: Windows ² / Linux None
    key <AE02> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 2, quotedbl, at, twosuperior ] };
    // shiftaltgr: Windows £ / Linux None
    key <AE03> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 3, numbersign, threesuperior, sterling ] };
    // shiftaltgr: Windows ¤ / Linux None
    key <AE04> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 4, dollar, onequarter, currency ] };
    // shiftaltgr: Windows dead:` / Linux None
    key <BKSL> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ agrave, Agrave, dead_grave, dead_grave ] };
};
