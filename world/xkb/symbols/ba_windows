// Part of the world prototype of belgian-azerty-linux; not released.

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "rs"
    name[Group1] = "Bosnian (Cyrillic, as on Windows)";
    // Windows layout: "Bosnian (Cyrillic)" (CLDR bs-Cyrl-t-k0-windows.xml); 5 keys differ from Linux
    // base: Windows ѕ / Linux ж; shift: Windows Ѕ / Linux Ж; caps: Windows Ѕ / Linux Ж; capsshift: Windows ѕ / Linux ж
    key <AB01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Macedonia_dse, Macedonia_DSE, leftsinglequotemark, NoSymbol ] };
    // altgr: Windows § / Linux ^
    key <AB07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Cyrillic_em, Cyrillic_EM, section, NoSymbol ] };
    // altgr: Windows ^ / Linux dead:^
    key <AE03> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 3, numbersign, asciicircum, NoSymbol ] };
    // altgr: Windows ° / Linux 5
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 5, percent, degree, percent ] };
    // base: Windows dead:' / Linux '; caps: Windows dead:' / Linux '  [base: no keysym for "dead:'", kept Linux]
    key <AE11> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ apostrophe, question, dead_macron, NoSymbol ] };
};
