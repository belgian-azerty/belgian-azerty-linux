    // base: Windows գ / Linux ք; shift: Windows Գ / Linux Ք; caps: Windows Գ / Linux Ք; capsshift: Windows գ / Linux ք
    key <AB03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Armenian_gim, Armenian_GIM, Armenian_ke, Armenian_KE ] };
    // base: Windows ք / Linux գ; shift: Windows Ք / Linux Գ; caps: Windows Ք / Linux Գ; capsshift: Windows ք / Linux գ
    key <AC05> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Armenian_ke, Armenian_KE, Armenian_gim, Armenian_GIM ] };
    // base: Windows : / Linux ։; shift: Windows 1 / Linux ։; caps: Windows : / Linux ։; capsshift: Windows 1 / Linux ։
    key <AE01> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ colon, 1, Armenian_full_stop, Armenian_full_stop ] };
    // shift: Windows 3 / Linux ՛; capsshift: Windows 3 / Linux ՛
    key <AE04> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ Armenian_accent, 3, Armenian_accent, Armenian_accent ] };
    // shift: Windows 4 / Linux ,; capsshift: Windows 4 / Linux ,
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ comma, 4, comma, comma ] };
    // shift: Windows 9 / Linux -; capsshift: Windows 9 / Linux -
    key <AE06> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ minus, 9, minus, minus ] };
    // Caps Lock keeps . as on Windows (made explicit: newer libxkbcommon would capitalise it)
    key <AE07> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ period, Armenian_ligature_ew, period, Armenian_ligature_ew, period ] };
    // base: Windows ' / Linux <; shift: Windows ՞ / Linux >; caps: Windows ' / Linux <; capsshift: Windows ՞ / Linux >
    key <LSGT> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ apostrophe, Armenian_question, less, greater ] };
};

