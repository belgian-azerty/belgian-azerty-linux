// Part of the world prototype of belgian-azerty-linux; not released.

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "pt"
    name[Group1] = "Portuguese (as on Windows)";
    // Windows layout: "Portuguese" (CLDR pt-PT-t-k0-windows.xml); 2 keys differ from Linux
    // altgr: Windows ] / Linux dead:~
    key <AD12> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ dead_acute, dead_grave, bracketright, dead_macron ] };
    // altgr: Windows € / Linux ½
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 5, percent, EuroSign, threeeighths ] };
};
