default partial alphanumeric_keys
xkb_symbols "basic" {
    include "latam(deadtilde)"
    name[Group1] = "Guarani (as on Windows)";
    // Windows layout: "Guarani" (CLDR gn-t-k0-windows.xml); 6 keys differ from Linux
    // altgr: Windows ã / Linux æ; shiftaltgr: Windows Ã / Linux Æ
    key <AC01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ a, A, atilde, Atilde ] };
    // altgr: Windows ẽ / Linux €; shiftaltgr: Windows Ẽ / Linux ¢
    key <AD03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ e, E, etilde, Etilde ] };
    // altgr: Windows ỹ / Linux ←; shiftaltgr: Windows Ỹ / Linux ¥
    key <AD06> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ y, Y, ytilde, Ytilde ] };
    // altgr: Windows ũ / Linux ↓; shiftaltgr: Windows Ũ / Linux ↑
    key <AD07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ u, U, utilde, Utilde ] };
    // altgr: Windows ĩ / Linux →; shiftaltgr: Windows Ĩ / Linux ı
    key <AD08> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ i, I, itilde, Itilde ] };
    // altgr: Windows õ / Linux ø; shiftaltgr: Windows Õ / Linux Ø
    key <AD09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ o, O, otilde, Otilde ] };
};
