// tr_windows: keyboard layouts that type like Windows, generated by world/tools/gen_windows_symbols.py
// from Unicode CLDR 43 Windows keyboard data. Do not edit by hand: change the generator and run it again.
// Each section includes the Linux layout unchanged and redefines only the keys where Windows differs.
// CLDR data: Copyright (c) Unicode, Inc., Unicode License (world/cldr-43/LICENSE.txt).
// Part of the world prototype of belgian-azerty-linux; not released.

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "tr"
    name[Group1] = "Turkish (Q, as on Windows)";
    // Windows layout: "Turkish Q" (CLDR tr-t-k0-windows.xml); 8 keys differ from Linux
    // capsshift: Windows é / Linux É
    key <TLDE> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ quotedbl, eacute, less, degree, quotedbl ] };
    // altgr: Windows æ / Linux â; shiftaltgr: Windows Æ / Linux Â
    key <AC01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ a, A, ae, AE ] };
    // altgr: Windows dead:´ / Linux ´  [altgr: accent key ´ as on Windows; Linux accent table differs on 3 sequences (e.g.  ->´ (Linux '), ı->í (Linux None), İ->Í (Linux None)): accent-space gives the Windows results]
    key <AC10> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ scedilla, Scedilla, dead_acute, dead_acute ] };
    // Caps Lock keeps İ as on Windows (made explicit: newer libxkbcommon would capitalise it)
    key <AC11> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ i, Iabovedot, apostrophe, dead_caron ] };
    // altgr: Windows i / Linux î; shiftaltgr: Windows İ / Linux Î
    key <AD08> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ idotless, I, i, Iabovedot ] };
    // altgr: Windows dead:~ / Linux ~
    key <AD12> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ udiaeresis, Udiaeresis, dead_tilde, dead_macron ] };
    // shift: Windows dead:^ / Linux ^; capsshift: Windows dead:^ / Linux ^  [shift: accent key ^ as on Windows; Linux accent table differs on 2 sequences (e.g. ı->î (Linux None), İ->Î (Linux None)): accent-space gives the Windows results]
    key <AE03> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 3, dead_circumflex, numbersign, threesuperior ] };
    // altgr: Windows dead:` / Linux `  [altgr: accent key ` as on Windows; Linux accent table differs on 2 sequences (e.g. ı->ì (Linux None), İ->Ì (Linux None)): accent-space gives the Windows results]
    key <BKSL> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ comma, semicolon, dead_grave, dead_grave ] };
};

partial alphanumeric_keys
xkb_symbols "f" {
    include "tr(f)"
    name[Group1] = "Turkish (F, as on Windows)";
    // Windows layout: "Turkish F" (CLDR tr-t-k0-windows-legacy.xml); 13 keys differ from Linux
    // altgr: Windows ¢ / Linux “; shiftaltgr: Windows © / Linux None
    key <AB03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ v, V, cent, copyright ] };
    // altgr: Windows µ / Linux §; shiftaltgr: Windows º / Linux None
    key <AB07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ s, S, mu, ordmasculine ] };
    // altgr: Windows ­ / Linux ·
    key <AB10> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ comma, semicolon, hyphen, VoidSymbol ] };
    // altgr: Windows æ / Linux û; shiftaltgr: Windows Æ / Linux Û
    key <AC01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ u, U, ae, AE ] };
    // altgr: Windows ß / Linux î; shiftaltgr: Windows § / Linux Î
    key <AC02> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ i, Iabovedot, ssharp, section ] };
    // shiftaltgr: Windows ª / Linux Â
    key <AC04> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ a, A, acircumflex, ordfeminine ] };
    // altgr: Windows dead:´ / Linux ´  [altgr: accent key ´ as on Windows; Linux accent table differs on 3 sequences (e.g.  ->´ (Linux '), ı->í (Linux None), İ->Í (Linux None)): accent-space gives the Windows results]
    key <AC10> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ y, Y, dead_acute, dead_acute ] };
    // shiftaltgr: Windows ® / Linux None
    key <AD04> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ idotless, I, paragraph, registered ] };
    // altgr: Windows ø / Linux °; shiftaltgr: Windows Ø / Linux None
    key <AD09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ h, H, oslash, Oslash ] };
    // altgr: Windows dead:~ / Linux ~
    key <AD12> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ w, W, dead_tilde, dead_breve ] };
    // shift: Windows dead:^ / Linux ^; capsshift: Windows dead:^ / Linux ^  [shift: accent key ^ as on Windows; Linux accent table differs on 2 sequences (e.g. ı->î (Linux None), İ->Î (Linux None)): accent-space gives the Windows results]
    key <AE03> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 3, dead_circumflex, numbersign, threesuperior ] };
    // shiftaltgr: Windows ¤ / Linux None
    key <AE04> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 4, dollar, onequarter, currency ] };
    // altgr: Windows dead:` / Linux `  [altgr: accent key ` as on Windows; Linux accent table differs on 2 sequences (e.g. ı->ì (Linux None), İ->Ì (Linux None)): accent-space gives the Windows results]
    key <BKSL> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ x, X, dead_grave, dead_grave ] };
};
