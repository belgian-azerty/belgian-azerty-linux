// Part of the world prototype of belgian-azerty-linux; not released.

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "ma(tifinagh-extended)"
    name[Group1] = "Berber (Tifinagh, extended, as on Windows)";
    // Windows layout: "Tifinagh (Extended)" (CLDR tmh-t-k0-windows-extended.xml); 3 keys differ from Linux
    // shift: Windows ‍ / Linux ‌; capsshift: Windows ‍ / Linux ‌
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ twosuperior, U200D, twosuperior, U200C ] };
    // base: Windows ‌ / Linux ‍; caps: Windows ‌ / Linux ‍
    key <AE10> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U200C, 0, at, NoSymbol ] };
    // capsshift: Windows µ / Linux None
    key <BKSL> { type[Group1] = "FOUR_LEVEL_PLUS_LOCK", symbols[Group1] = [ asterisk, mu, asterisk, mu, asterisk ] };
};
