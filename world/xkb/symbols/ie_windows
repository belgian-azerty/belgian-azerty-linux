default partial alphanumeric_keys
xkb_symbols "basic" {
    include "gb(extd)"
    name[Group1] = "Irish (as on Windows)";
    // Windows layout: "Irish" (CLDR ga-t-k0-windows.xml); 1 keys differ from Linux
    // shiftaltgr: Windows ¦ / Linux ¬
