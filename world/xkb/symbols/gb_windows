default partial alphanumeric_keys
xkb_symbols "basic" {
    include "gb"
    name[Group1] = "English (UK, as on Windows)";
    // Windows layout: "United Kingdom" (CLDR en-GB-t-k0-windows.xml); 7 keys differ from Linux
    // altgr: Windows ¦ / Linux |
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ grave, notsign, brokenbar, bar ] };
    // altgr: Windows á / Linux æ; shiftaltgr: Windows Á / Linux Æ
    key <AC01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ a, A, aacute, Aacute ] };
    // altgr: Windows é / Linux e; shiftaltgr: Windows É / Linux E
    key <AD03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ e, E, eacute, Eacute ] };
    // altgr: Windows ú / Linux ↓; shiftaltgr: Windows Ú / Linux ↑
    key <AD07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ u, U, uacute, Uacute ] };
    // altgr: Windows í / Linux →; shiftaltgr: Windows Í / Linux ı
    key <AD08> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ i, I, iacute, Iacute ] };
    // altgr: Windows ó / Linux ø; shiftaltgr: Windows Ó / Linux Ø
    key <AD09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ o, O, oacute, Oacute ] };
    // altgr: Windows \ / Linux dead:`; shiftaltgr: Windows | / Linux dead:˘
    key <BKSL> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ numbersign, asciitilde, backslash, bar ] };
};
