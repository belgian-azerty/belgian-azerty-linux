default partial alphanumeric_keys
xkb_symbols "basic" {
    include "rs"
    name[Group1] = "Serbian (Cyrillic, as on Windows)";
    // Windows layout: "Serbian (Cyrillic)" (CLDR sr-t-k0-windows.xml); 2 keys differ from Linux
    // base: Windows ѕ / Linux ж; shift: Windows Ѕ / Linux Ж; caps: Windows Ѕ / Linux Ж; capsshift: Windows ѕ / Linux ж
    key <AB01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ Macedonia_dse, Macedonia_DSE, leftsinglequotemark, NoSymbol ] };
    // base: Windows dead:' / Linux '; caps: Windows dead:' / Linux '  [base: no keysym for "dead:'", kept Linux]
    key <AE11> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ apostrophe, question, dead_macron, NoSymbol ] };
};

partial alphanumeric_keys
xkb_symbols "latin" {
    include "rs(latin)"
    name[Group1] = "Serbian (Latin, as on Windows)";
    // Windows layout: "Serbian (Latin)" (CLDR sr-Latn-t-k0-windows.xml); 4 keys differ from Linux
    // base: Windows dead:‚ / Linux `; caps: Windows dead:‚ / Linux `  [base: no keysym for 'dead:‚', kept Linux]
    key <TLDE> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ grave, asciitilde, notsign, notsign ] };
    // altgr: Windows Ł / Linux ł
    key <AC09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ l, L, Lstroke, Lstroke ] };
    // altgr: Windows ~ / Linux dead:~
    key <AE01> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 1, exclam, asciitilde, asciitilde ] };
    // altgr: Windows ` / Linux dead:`
    key <AE07> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 7, slash, grave, grave ] };
};
