// Part of the world prototype of belgian-azerty-linux; not released.

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "tj"
    name[Group1] = "Tajik (as on Windows)";
    // Windows layout: "Tajik" (CLDR tg-t-k0-windows.xml); 2 keys differ from Linux
    // caps: Windows / / Linux \; capsshift: Windows \ / Linux /
    key <BKSL> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ backslash, slash, backslash, slash ] };
    // base: Windows \ / Linux /; shift: Windows / / Linux |; capsshift: Windows \ / Linux |
    key <LSGT> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", symbols[Group1] = [ backslash, slash, bar, brokenbar ] };
};
