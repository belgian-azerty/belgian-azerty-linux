default partial alphanumeric_keys
xkb_symbols "basic" {
    include "kh"
    name[Group1] = "Khmer (NIDA, as on Windows)";
    // Windows layout: "Khmer (NIDA)" (CLDR km-t-k0-windows-extended.xml); 1 keys differ from Linux
    // altgr: Windows × / Linux x
    key <AE11> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ U17A5, U17CC, multiply, VoidSymbol ] };
};
