default partial alphanumeric_keys
xkb_symbols "basic" {
    include "es"
    name[Group1] = "Spanish (as on Windows)";
    // Windows layout: "Spanish" (CLDR es-t-k0-windows.xml); 2 keys differ from Linux
    // altgr: Windows dead:~ / Linux ~
    key <AE04> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 4, dollar, dead_tilde, dollar ] };
    // altgr: Windows € / Linux ½
    key <AE05> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ 5, percent, EuroSign, threeeighths ] };
};
