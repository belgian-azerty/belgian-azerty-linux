// Shift+AltGr on ù, µ and = as on Windows "Belgian (Period)" / "Belgian (Comma)": the same accent as AltGr (´ ` ~),
// so Shift+AltGr+ù then e gives é. Standard Linux Belgian has caron, breve and dot above there (ǎ ă ȧ); the Linux
// profile (or ACCENTS=linux) keeps them. Option be_azerty:accents.
hidden partial alphanumeric_keys
xkb_symbols "windows_accents" {
    key <AC11> { [ NoSymbol, NoSymbol, NoSymbol, dead_acute ] };
    key <BKSL> { [ NoSymbol, NoSymbol, NoSymbol, dead_grave ] };
    key <AB10> { [ NoSymbol, NoSymbol, NoSymbol, dead_tilde ] };
};

